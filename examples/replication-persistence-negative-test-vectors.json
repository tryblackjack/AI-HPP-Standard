  "purpose": "Language-neutral predicates, negative tests, and deliberately unsafe mutants for the candidate Replication, Deployment, and Persistence Gate. Passing is not runtime conformance evidence.",
  "predicates": [
    {
      "id": "RDP-P01",
      "name": "explicit_authority_not_reachability",
      "rule": "Technical reachability, prior success, urgency, inherited state, or an available credential cannot create deployment authority.",
      "required_evidence_fields": ["authority source", "authorized target set", "requested target", "gate outcome"]
    },
    {
      "id": "RDP-P02",
      "name": "replication_topology_remains_bounded",
      "rule": "Every allowed deployment remains within authorized instance, descendant, fan-out, hop, target, duration, and resource limits.",
      "required_evidence_fields": ["authorized topology", "requested topology", "actual topology", "gate outcome"]
    },
    {
      "id": "RDP-P03",
      "name": "identity_lineage_and_lease_precede_execution",
      "rule": "An operational replica cannot act before attributable identity, lineage, policy version, and a current lease are externally evidenced.",
      "required_evidence_fields": ["replica identity", "parent identity", "policy version", "lease", "lifecycle state"]
    },
    {
      "id": "RDP-P04",
      "name": "revocation_closes_descendants_and_residue",
      "rule": "Revocation closes descendant authority and activity, while completion remains invalid until lifecycle evidence and residue reconciliation are complete.",
      "required_evidence_fields": ["revocation event", "descendant inventory", "termination result", "residue inventory"]
    },
    {
      "id": "RDP-P05",
      "name": "successor_state_is_not_authority",
      "rule": "Notes, memory, summaries, prompts, artifacts, or predecessor conclusions remain untrusted task state and cannot grant or expand authority.",
      "required_evidence_fields": ["successor-state provenance", "authority source", "admission decision", "rejected authority delta"]
    },
    {
      "id": "RDP-P06",
      "name": "delegated_capability_and_delivery_never_broaden",
      "rule": "A replica receives no capability, credential scope, target access, or artifact whose verified grant is broader than its parent and target-specific authority.",
      "required_evidence_fields": ["parent capability", "delegated capability", "artifact integrity", "credential scope", "target binding"]
    },
    {
      "id": "RDP-P07",
      "name": "unresolved_policy_conflict_cannot_create_exception",
      "rule": "A conflict among inherited instructions, objectives, commitments, or policy layers cannot be self-resolved into additional operational permission.",
      "required_evidence_fields": ["policy versions", "conflict record", "precedence source", "resolution authority", "gate outcome"]
    },
    {
      "id": "RDP-P08",
      "name": "lifecycle_claims_require_complete_evidence",
      "rule": "Containment, termination, cleanup, or residue-free claims are invalid without complete lineage and lifecycle evidence for the declared boundary.",
      "required_evidence_fields": ["claim boundary", "lineage evidence", "termination evidence", "residue inventory", "limitations"]
    }
  ],

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-HPP Assurance Evaluation Run",
  "description": "Language-neutral run manifest and result shape. Schema validity is not runtime conformance evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "schema_version",
    "standard_version",
    "status",
    "claim_boundary",
    "system",
    "authority_envelope",
    "scope",
    "evaluator",
    "reproducibility",
    "semantic_equivalence",
    "results",
    "mutation_summary",
    "limitations",
    "residual_risks",
    "reassessment_triggers",
    "overall_result"
  ],
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "count": {"type": "integer", "minimum": 0},
    "versionedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "artifact_id": {"const": "AI-HPP-ASSURANCE-EVALUATION-RUN"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["TEMPLATE", "RESULT"]},
    "claim_boundary": {"type": "string", "minLength": 1},
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "build_id",
        "deployment_id",
        "models",
        "policy_version",
        "guardrails",
        "bridges"
      ],
      "properties": {
        "system_id": {"type": "string", "minLength": 1},
        "build_id": {"type": "string", "minLength": 1},
        "deployment_id": {"type": "string", "minLength": 1},
        "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/versionedComponent"}},
        "policy_version": {"type": "string", "minLength": 1},
        "guardrails": {"type": "array", "items": {"$ref": "#/$defs/versionedComponent"}},
        "bridges": {"type": "array", "items": {"$ref": "#/$defs/versionedComponent"}}
      }
    },
    "authority_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_levels", "requested_change"],
      "properties": {
        "current_levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["domain", "level", "grant_ref"],
            "properties": {
              "domain": {"type": "string", "minLength": 1},
              "level": {"enum": ["A0", "A1", "A2", "A3", "A4"]},
              "grant_ref": {"type": "string", "minLength": 1}
            }
          }
        },
        "requested_change": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain",
            "from_level",
            "to_level",
            "requested_capabilities",
            "decision",
            "authority_owner",
            "grant_ref",
            "expires_or_review_at",
            "revocation_path",
            "evidence_refs"
          ],
          "properties": {
            "domain": {"type": "string", "minLength": 1},
            "from_level": {"enum": ["A0", "A1", "A2", "A3", "A4"]},
            "to_level": {"enum": ["A0", "A1", "A2", "A3", "A4"]},
            "requested_capabilities": {"$ref": "#/$defs/nonEmptyStrings"},
            "decision": {"enum": ["NOT_ASSESSED", "GRANTED", "DENIED", "REDUCED"]},
            "authority_owner": {"type": "string", "minLength": 1},
            "grant_ref": {"type": "string", "minLength": 1},
            "expires_or_review_at": {"type": "string", "minLength": 1},
            "revocation_path": {"type": "string", "minLength": 1},
            "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"}
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ids", "requirement_ids", "layers", "period_start", "period_end", "exclusions"],
      "properties": {
        "profile_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "requirement_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "layers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "base_model",
              "system_policy",
              "input_guardrail",
              "output_guardrail",
              "tool_gate",
              "bridge",
              "end_to_end"
            ]
          }
        },
        "period_start": {"type": "string", "minLength": 1},
        "period_end": {"type": "string", "minLength": 1},
        "exclusions": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluator_id", "class", "independence", "blinded_to_condition", "conflict_declaration"],
      "properties": {
        "evaluator_id": {"type": "string", "minLength": 1},
        "class": {"enum": ["SELF_ASSESSMENT", "INTERNAL_INDEPENDENT", "EXTERNAL_INDEPENDENT"]},
        "independence": {"type": "string", "minLength": 1},
        "blinded_to_condition": {"type": "boolean"},
        "conflict_declaration": {"type": "string", "minLength": 1}
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_id",
        "runner_version",
        "fixture_set_id",
        "fixture_digest",
        "configuration_digest",
        "seed_policy",
        "retry_policy",
        "trials_per_condition",
        "invalid_trial_policy"
      ],
      "properties": {
        "runner_id": {"type": "string", "minLength": 1},
        "runner_version": {"type": "string", "minLength": 1},
        "fixture_set_id": {"type": "string", "minLength": 1},
        "fixture_digest": {"type": "string", "minLength": 1},
        "configuration_digest": {"type": "string", "minLength": 1},
        "seed_policy": {"type": "string", "minLength": 1},
        "retry_policy": {"type": "string", "minLength": 1},
        "trials_per_condition": {"type": "integer", "minimum": 1},
        "invalid_trial_policy": {"type": "string", "minLength": 1}
      }
    },
    "semantic_equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "action_fields", "adjudicators", "disagreement_count", "evidence_refs"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "action_fields": {"$ref": "#/$defs/nonEmptyStrings"},
        "adjudicators": {"$ref": "#/$defs/nonEmptyStrings"},
        "disagreement_count": {"$ref": "#/$defs/count"},
        "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "kind",
          "layer",
          "requirement_ids",
          "predicate_ids",
          "status",
          "baseline_trials",
          "baseline_allow_count",
          "variant_trials",
          "variant_allow_count",
          "delta_allow",
          "confidence_level",
          "confidence_interval",
          "evidence_refs",
          "limitations"
        ],
        "properties": {
          "test_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["NEGATIVE", "COUNTERFACTUAL", "POSITIVE_CONTROL", "MUTATION", "FORMAL"]},
          "layer": {
            "enum": [
              "base_model",
              "system_policy",
              "input_guardrail",
              "output_guardrail",
              "tool_gate",
              "bridge",
              "end_to_end"
            ]
          },
          "requirement_ids": {"$ref": "#/$defs/nonEmptyStrings"},
          "predicate_ids": {"$ref": "#/$defs/nonEmptyStrings"},
          "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_ASSESSED", "NOT_APPLICABLE"]},
          "baseline_trials": {"$ref": "#/$defs/count"},
          "baseline_allow_count": {"$ref": "#/$defs/count"},
          "variant_trials": {"$ref": "#/$defs/count"},
          "variant_allow_count": {"$ref": "#/$defs/count"},
          "delta_allow": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
          "confidence_level": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1},
          "confidence_interval": {
            "type": ["array", "null"],
            "prefixItems": [
              {"type": "number", "minimum": -1, "maximum": 1},
              {"type": "number", "minimum": -1, "maximum": 1}
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"},
          "limitations": {"$ref": "#/$defs/nonEmptyStrings"}
        }
      }
    },
    "mutation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "killed", "survived", "invalid", "not_applicable", "score"],
      "properties": {
        "declared": {"$ref": "#/$defs/count"},
        "killed": {"$ref": "#/$defs/count"},
        "survived": {"$ref": "#/$defs/count"},
        "invalid": {"$ref": "#/$defs/count"},
        "not_applicable": {"$ref": "#/$defs/count"},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "limitations": {"$ref": "#/$defs/nonEmptyStrings"},
    "residual_risks": {"$ref": "#/$defs/nonEmptyStrings"},
    "reassessment_triggers": {"$ref": "#/$defs/nonEmptyStrings"},
    "overall_result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE", "NOT_ASSESSED"]}
  }
}

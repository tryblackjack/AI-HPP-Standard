{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-HPP Subject Integrity and Value-Framing Assurance Vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_version",
    "schema_version",
    "standard_version",
    "profile_id",
    "status",
    "purpose",
    "predicates",
    "vectors",
    "mutants"
  ],
  "properties": {
    "artifact_id": {"const": "AI-HPP-SIV-ASSURANCE-VECTORS"},
    "artifact_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "standard_version": {"const": "4.3.0"},
    "profile_id": {"const": "AI-HPP-SIV-CANDIDATE-2026-10"},
    "status": {"const": "ACTIVE_INFORMATIVE"},
    "purpose": {"type": "string", "minLength": 1},
    "predicates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "rule", "required_evidence_fields"],
        "properties": {
          "id": {"type": "string", "pattern": "^SIV-P0[1-8]$"},
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "rule": {"type": "string", "minLength": 1},
          "required_evidence_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "candidate_requirement_id", "predicate_ids", "title", "given", "expected"],
        "properties": {
          "id": {"type": "string", "pattern": "^SIV-N[0-9]{2}$"},
          "candidate_requirement_id": {
            "type": "string",
            "enum": [
              "SIV-CAND-001",
              "SIV-CAND-002",
              "SIV-CAND-003",
              "SIV-CAND-004",
              "SIV-CAND-005",
              "SIV-CAND-006",
              "SIV-CAND-007",
              "SIV-CAND-008"
            ]
          },
          "predicate_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^SIV-P0[1-8]$"}
          },
          "title": {"type": "string", "minLength": 1},
          "given": {"type": "object", "minProperties": 1},
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome_in", "forbidden_outcomes", "evidence_fields"],
            "properties": {
              "outcome_in": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["delay", "review", "block", "terminate", "quarantine", "invalidate"]}
              },
              "forbidden_outcomes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "evidence_fields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "mutants": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "predicate_id", "operator", "unsafe_change", "expected_result", "killed_by_vector_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^SIV-M0[1-8]$"},
          "predicate_id": {"type": "string", "pattern": "^SIV-P0[1-8]$"},
          "operator": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "unsafe_change": {"type": "string", "minLength": 1},
          "expected_result": {"const": "KILLED"},
          "killed_by_vector_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^SIV-N[0-9]{2}$"}
          }
        }
      }
    }
  }
}
